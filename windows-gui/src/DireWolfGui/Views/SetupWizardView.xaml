<UserControl x:Class="DireWolfGui.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DireWolfGui.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Style="{StaticResource PageTitle}" Text="Setup wizard" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding FirstRunText}" />
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" SelectedIndex="{Binding StepIndex}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Wizard steps">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:WizardStep}">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="2,4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False" />

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,0">
            <Grid MaxWidth="980" HorizontalAlignment="Left">
                <!-- 1 Dire Wolf program -->
                <StackPanel Visibility="{Binding Steps[0].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10"
                               Text="Dire Wolf Station controls Dire Wolf, the sound-card packet modem and TNC by John Langner, WB2OSZ. Choose direwolf.exe. If you do not have it yet, download an official Windows release, or build it from source (see the README and User Guide in the Dire Wolf repository). Real-parser checks (--check-config) and the experimental WAPR modem need a Dire Wolf build that includes them." />
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Download page (github.com/wb2osz/direwolf/releases)" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding DownloadUrl}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Source code and documentation" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding SourceUrl}" Padding="10,4" Margin="0,0,6,6" />
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FormLabel}" Text="direwolf.exe" />
                        <TextBox Grid.Column="1" Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Path of direwolf.exe" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Browse…" Command="{Binding BrowseExeCommand}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Search usual places" Command="{Binding FindExeCommand}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Show version" Command="{Binding DetectVersionCommand}" Padding="10,4" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding VersionText}" Margin="0,8,0,0"
                               Foreground="{Binding VersionKind, Converter={StaticResource ThemeBrush}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="The version is read by running direwolf -t 0 -u, which prints its banner and exits without opening any audio device or port." />
                </StackPanel>

                <!-- 2 Configuration file -->
                <StackPanel Visibility="{Binding Steps[1].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <RadioButton Content="Create a new configuration (the next steps ask for the details)" IsChecked="{Binding CreateNew}" GroupName="ConfigChoice" Margin="0,0,0,8" />
                    <RadioButton Content="Use an existing configuration file as it is" IsChecked="{Binding UseExisting}" GroupName="ConfigChoice" Margin="0,0,0,8" />
                    <Grid Margin="24,0,0,0" IsEnabled="{Binding UseExisting}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExistingPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Existing configuration file" />
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseExistingCommand}" Padding="10,4" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="With an existing file, Next selects it and goes straight to the receive-only test; the file itself is not changed. You can still use the audio level meter in step 3. Edit the file later on the Configuration page." />
                </StackPanel>

                <!-- 3 Audio -->
                <StackPanel Visibility="{Binding Steps[2].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8"
                               Text="Choose the sound device connected to the radio: its input receives, its output transmits. A USB interface (SignaLink, Digirig, a CM108-based adapter) appears as a separate device." />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" Padding="10,4" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DevicesNote}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Input (receive audio from the radio)" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" Height="130" AutomationProperties.Name="Input devices" />
                            <TextBlock Style="{StaticResource Caption}" Text="Written to ADEVICE as (number or part of the name):" Margin="0,6,0,2" />
                            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Input device as written in the configuration" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Output (transmit audio to the radio)" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" Height="130" AutomationProperties.Name="Output devices" />
                            <TextBlock Style="{StaticResource Caption}" Text="Written to ADEVICE as:" Margin="0,6,0,2" />
                            <TextBox Text="{Binding OutputText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output device as written in the configuration" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource FormLabel}" Text="Sample rate" />
                        <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" Width="220" AutomationProperties.Name="Sample rate" />
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Receive level" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Start listening" Command="{Binding StartMeterCommand}" Padding="10,4" Margin="0,0,6,0" />
                                <Button Content="Stop" Command="{Binding StopMeterCommand}" Padding="10,4" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="Left / mono" />
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LevelLeft, Mode=OneWay}" Height="14" Margin="0,4"
                                             AutomationProperties.Name="Left or mono input level, percent of full scale" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Right" />
                                <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LevelRight, Mode=OneWay}" Height="14" Margin="0,4"
                                             AutomationProperties.Name="Right input level, percent of full scale" />
                            </Grid>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding MeterText}" Foreground="{Binding MeterKind, Converter={StaticResource ThemeBrush}}" Margin="0,6,0,6" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="This meter shows the peak in percent of full scale; it is not the same scale as the 'audio level' number Dire Wolf prints for each packet. Open the squelch (or tune to a busy channel): received packets should be clearly visible but never reach 100 % (clipping distorts them). Then fine-tune with Dire Wolf's own audio level reports in the receive test; the Dire Wolf User Guide suggests aiming for around 50 there." />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Windows audio tips" Margin="0,10,0,4" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="• Sound settings → the recording device → Properties: turn off all enhancements, noise suppression and automatic gain control (AGC); they distort packet tones.&#x0a;• Set the recording level (and 'Microphone boost' if present) so the meter above shows clear but unclipped signals; set the playback level to what your radio interface expects.&#x0a;• Advanced tab: pick 44100 Hz or 48000 Hz, 16 bit; untick 'Allow applications to take exclusive control' if another program blocks the device, or leave it ticked if Windows sounds leak into the transmit audio.&#x0a;• Make the interface NOT the Windows default device, so system sounds are never transmitted.&#x0a;• SignaLink: set TX/RX levels with its knobs and keep its delay short; Digirig: PTT is usually its serial port RTS line (step 6)." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4 Channels -->
                <StackPanel Visibility="{Binding Steps[3].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <CheckBox Content="Two radios on one sound card (stereo: left = channel 0, right = channel 1)" IsChecked="{Binding Stereo}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                               Text="Most stations use one radio: mono, channel 0. With a stereo sound card, the left and right channels can each serve a radio (ACHANNELS 2). More sound cards (up to three) can be added later on the Configuration page." />
                </StackPanel>

                <!-- 5 Modem -->
                <StackPanel Visibility="{Binding Steps[4].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardChannel}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" Margin="0,0,0,6" />
                                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseWapr, Converter={StaticResource InverseBool}}">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Speed (bps)" />
                                            <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" Width="110" AutomationProperties.Name="Modem speed" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SpeedHelp}" Margin="0,4,0,8" />
                                        <CheckBox Content="Use the EXPERIMENTAL WAPR modem on this channel instead (asks for confirmation)" IsChecked="{Binding UseWapr}"
                                                  IsEnabled="{Binding DataContext.WaprAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <StackPanel Orientation="Horizontal" Margin="24,6,0,0" Visibility="{Binding UseWapr, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Profile" />
                                            <ComboBox ItemsSource="{Binding WaprProfiles}" SelectedItem="{Binding WaprProfile}" Width="90" AutomationProperties.Name="WAPR profile" />
                                            <TextBlock Style="{StaticResource FormLabel}" Text="AIRTIME limit % (optional)" Margin="16,4,8,4" />
                                            <TextBox Text="{Binding WaprAirtime, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="WAPR airtime limit in percent" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource InfoBanner}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding WaprState}" />
                            <Button Content="Check this Dire Wolf build" Command="{Binding CheckBuildCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6 PTT -->
                <StackPanel Visibility="{Binding Steps[5].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="How Dire Wolf switches the radio to transmit. Choose 'No PTT' to only receive. The wizard never tests transmitting; once a PTT method is set, transmissions start only when something you enable (a client program, beacon, digipeater or IGate) sends." />
                    <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardChannel}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding PttDescriptions}" SelectedIndex="{Binding PttIndex}" AutomationProperties.Name="PTT method">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="640" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Serial port" />
                                            <ComboBox IsEditable="True" ItemsSource="{Binding Ports}" Text="{Binding PttPort, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                      AutomationProperties.Name="Serial port" />
                                            <CheckBox Content="Inverted (active low)" IsChecked="{Binding PttInvert}" Margin="16,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsCm108, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource FormLabel}" Text="GPIO (empty = 3)" />
                                                <TextBox Text="{Binding Cm108Gpio, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="CM108 GPIO" />
                                                <CheckBox Content="Inverted" IsChecked="{Binding PttInvert}" Margin="16,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Style="{StaticResource FormLabel}" Text="HID device (optional)" />
                                                <TextBox Text="{Binding Cm108Device, UpdateSourceTrigger=PropertyChanged}" Width="360" AutomationProperties.Name="CM108 HID device path" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Serial ports are listed as COM1 to COM20; Device Manager → Ports (COM &amp; LPT) shows which one your interface uses. You can type another name." />
                </StackPanel>

                <!-- 7 Callsign -->
                <StackPanel Visibility="{Binding Steps[6].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FormLabel}" Text="Your callsign (optional -SSID)" />
                        <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="Callsign" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding CallsignError}" Foreground="{DynamicResource ErrorBrush}" Margin="0,6,0,0"
                               Visibility="{Binding CallsignError, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="1-6 letters and digits, optionally followed by -0 to -15. The placeholder N0CALL is not accepted. An SSID such as -10 is common for an IGate, -1 to -4 for digipeaters." />
                </StackPanel>

                <!-- 8 Network -->
                <StackPanel Visibility="{Binding Steps[7].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="APRS and packet programs connect to Dire Wolf over TCP: AGWPE-compatible programs to the AGW port, others to the KISS port. Any program that connects can transmit with your callsign. 0 turns a port off." />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource FormLabel}" Text="AGW port" Width="90" />
                        <TextBox Text="{Binding AgwPortText, UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="AGW port" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FormLabel}" Text="KISS port" Width="90" />
                        <TextBox Text="{Binding KissPortText, UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="KISS port" />
                    </StackPanel>
                    <CheckBox Content="Allow programs on other computers to connect (TCPBIND ANY; asks for confirmation)" IsChecked="{Binding AllowRemoteClients}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="24,4,0,0" TextWrapping="Wrap"
                               Text="Off (recommended): TCPBIND LOCAL, only programs on this computer can connect." />
                </StackPanel>

                <!-- 9 Check and save -->
                <StackPanel Visibility="{Binding Steps[8].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Check again" Command="{Binding ValidateCommand}" Padding="10,4" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ValidationStatus}" Foreground="{Binding ValidationKind, Converter={StaticResource ThemeBrush}}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ValidationResults}" Focusable="False" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DiagnosticRow}">
                                <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,1">
                                    <Run Text="{Binding Severity, Mode=OneWay}" Foreground="{Binding Kind, Converter={StaticResource ThemeBrush}}" FontWeight="SemiBold" />
                                    <Run Text="{Binding LineText, Mode=OneWay}" />
                                    <Run Text="{Binding Source, StringFormat='({0}):', Mode=OneWay}" />
                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Show the configuration that will be written" Margin="0,0,0,10">
                        <TextBox Text="{Binding GeneratedText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 MaxHeight="320" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Generated configuration" />
                    </Expander>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FormLabel}" Text="Save as" />
                        <TextBox Grid.Column="1" Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Where to save the configuration" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Browse…" Command="{Binding BrowseSaveCommand}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Save and use…" Command="{Binding SaveConfigCommand}" Padding="10,4" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding SaveStatus}" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"
                               Visibility="{Binding SaveStatus, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Saving shows exactly what will be written. An existing file is backed up first and never replaced without your confirmation." />
                </StackPanel>

                <!-- 10 Receive-only test -->
                <Grid Visibility="{Binding Steps[9].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding StepTitle}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Runs Dire Wolf with a separate test copy of your settings in which everything that could transmit is switched off: no PTT, no beacons, no digipeater, no IGate, and the AGW and KISS ports closed so no program can send. The copy is written to the file below; your configuration is not changed. Transmitting is never tested by the wizard." />
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TestConfigPath, StringFormat='Test configuration: {0}'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Start receive-only test" Command="{Binding StartTestCommand}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Stop" Command="{Binding StopTestCommand}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Finish setup" Command="{Binding FinishCommand}" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding TestStatus}" Margin="0,8,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Row="3" Margin="0,0,0,8">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Packets received" />
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding PacketCount}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Audio level reports" />
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding AudioLevelCount}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Last audio level (Dire Wolf's scale)" />
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding LastAudioLevel}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <Border Grid.Row="4" Background="{DynamicResource CodeBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <ListBox ItemsSource="{Binding ConsoleLines}" Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" VirtualizingPanel.IsVirtualizing="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Dire Wolf output during the test" />
                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="Dire Wolf's output appears here during the test."
                                       Visibility="{Binding ConsoleLines.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="5" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="No packets? Check that the radio is on a busy packet frequency with the squelch open or set low, the cable and the input device (step 3), and the receive level. 'Finish setup' marks the first-run setup as done; transmitting features stay off until you enable them on the Gateway &amp; digipeater page." />
                </Grid>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Command="{Binding NextCommand}" Padding="14,5" Margin="6,0,0,0" MinWidth="100">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Next" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72A;" FontSize="12" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding BackCommand}" Padding="14,5" MinWidth="100">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding StepTitle}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
