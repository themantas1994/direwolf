<UserControl x:Class="DireWolfGui.Views.WaprView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DireWolfGui.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="WAPR (experimental)" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="An experimental modem for small APRS-like frames on HF and VHF/UHF. Opt-in only: no channel is converted unless you do it here and confirm." />
            <Border Style="{StaticResource WarningBanner}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding ExperimentalNotice}" />
            </Border>
            <Border Style="{StaticResource InfoBanner}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding VerificationNote}" />
            </Border>

            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Session.IsDirty, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Review and save…" Command="{Binding SaveCommand}" Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="Discard" Command="{Binding RevertCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Text="The configuration has unsaved changes. Nothing changes for Dire Wolf until you save and restart it." />
                </DockPanel>
            </Border>

            <!-- Capability -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding CheckNowCommand}" Padding="10,4"
                                ToolTip="Runs direwolf --check-config on the selected configuration (opens no audio device, PTT or network port)" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="This Dire Wolf build" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding CapabilityText}" Foreground="{Binding CapabilityKind, Converter={StaticResource ThemeBrush}}" />
                </StackPanel>
            </Border>

            <!-- Profiles -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Profiles" />
                    <DataGrid ItemsSource="{Binding Profiles}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" AutomationProperties.Name="WAPR profiles">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="70" />
                            <DataGridTextColumn Header="Use" Binding="{Binding Use}" Width="*" />
                            <DataGridTextColumn Header="Symbol rate" Binding="{Binding SymbolRate}" Width="100" />
                            <DataGridTextColumn Header="Tones" Binding="{Binding Tones}" Width="170" />
                            <DataGridTextColumn Header="Airtime, 32-byte frame" Binding="{Binding FrameTime}" Width="160" />
                            <DataGridTextColumn Header="With TXDELAY 30 + TXTAIL 10" Binding="{Binding WithDefaults}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="On WAPR, TXDELAY and TXTAIL are keyed silence of the same length, so they add to each frame's time on air." />
                </StackPanel>
            </Border>

            <!-- Calculator -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Duty-cycle estimate" />
                    <WrapPanel>
                        <TextBlock Style="{StaticResource FormLabel}" Text="Profile" />
                        <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding CalcProfile}" Width="90" Margin="0,0,16,6" AutomationProperties.Name="Profile for the estimate" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Frames per hour" />
                        <TextBox Text="{Binding FramesPerHour, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,16,6" AutomationProperties.Name="Frames per hour" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="TXDELAY" />
                        <TextBox Text="{Binding TxDelay, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="0,0,16,6" AutomationProperties.Name="TXDELAY in 10 ms units" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="TXTAIL" />
                        <TextBox Text="{Binding TxTail, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="0,0,16,6" AutomationProperties.Name="TXTAIL in 10 ms units" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="AIRTIME limit %" />
                        <TextBox Text="{Binding AirtimeLimit, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="0,0,0,6" AutomationProperties.Name="Airtime limit in percent" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding DutyText}" Foreground="{Binding DutyKind, Converter={StaticResource ThemeBrush}}" Margin="0,4,0,2" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding WindowText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource FormLabel}" Text="Payload check" />
                        <TextBox Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}" Width="360" FontFamily="{StaticResource MonoFont}"
                                 AutomationProperties.Name="Information part to check" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding PayloadText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Not supported -->
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding IsNotSupported, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Body}" Text="Channel setup and gateway rules are disabled because WAPR support of this Dire Wolf build is not confirmed (see above)." />
            </Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding NoDocumentText}" />
            </Border>

            <!-- Channel setup -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsSupported}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Set up a WAPR channel" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FormLabel}" Text="Radio channel" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" Margin="0,2" AutomationProperties.Name="Radio channel for WAPR" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Profile" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SetupProfile}" Width="90" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="WAPR profile" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="AIRTIME limit % (optional)" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SetupAirtime, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Airtime limit percent" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,8" TextWrapping="Wrap"
                               Text="AIRTIME=percent limits the channel to that share of the time, averaged over 10 minutes; frames that do not fit are not sent and are logged (acknowledgements are always sent). A channel that already has an AX.25 MODEM line is only converted after a separate confirmation. Only channels whose audio device is configured are listed." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Make it a WAPR channel…" Command="{Binding ApplyChannelCommand}" Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="Change back to AX.25 (MODEM 1200)…" Command="{Binding RevertChannelCommand}" Padding="10,4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Gateway rules -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Gateway rules (WAPRGATE)" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="Without rules, nothing heard on a WAPR channel is IGated, digipeated or passed to other channels, and nothing heard elsewhere is sent on WAPR." />
                    <TextBlock Style="{StaticResource Caption}" Text="No WAPRGATE rules." Visibility="{Binding GateRows.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding GateRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ServiceLineRow}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Style="{StaticResource Caption}" Width="120" VerticalAlignment="Center">
                                        <Run Text="{Binding LineNumber, StringFormat='Line {0}', Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Mono}" Text="{Binding Text}" Width="320" VerticalAlignment="Center" />
                                    <Button Content="Disable" Padding="8,2" Margin="0,0,4,0" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.DisableGateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Enable…" Padding="8,2" Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.EnableGateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel IsEnabled="{Binding IsSupported}" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FormLabel}" Text="From channel" />
                            <ComboBox ItemsSource="{Binding GateChannelChoices}" SelectedItem="{Binding GateFrom}" Width="80" AutomationProperties.Name="Gateway from channel" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="to" Margin="16,4,8,4" />
                            <ComboBox ItemsSource="{Binding GateToChoices}" SelectedItem="{Binding GateTo}" Width="80" AutomationProperties.Name="Gateway to channel or IS" />
                        </StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Content="ALL types" IsChecked="{Binding GateAll}" Margin="0,0,16,4" />
                            <ItemsControl ItemsSource="{Binding GateTypes}" IsEnabled="{Binding GateAll, Converter={StaticResource InverseBool}}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GateTypeOption}">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,12,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding GateValidation}" Margin="0,6,0,8" />
                        <Button Content="Add rule…" Command="{Binding AddGateCommand}" HorizontalAlignment="Left" Padding="10,4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Runtime log -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetCountersCommand}" Padding="10,4" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="WAPR activity in Dire Wolf's output" />
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="Acknowledged" /><TextBlock Style="{StaticResource MetricValue}" Text="{Binding Acknowledged}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="Sent again" /><TextBlock Style="{StaticResource MetricValue}" Text="{Binding Resent}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="Gave up" /><TextBlock Style="{StaticResource MetricValue}" Text="{Binding GaveUp}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="Not sent: airtime limit" /><TextBlock Style="{StaticResource MetricValue}" Text="{Binding AirtimeRefused}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="Not sent: other reason" /><TextBlock Style="{StaticResource MetricValue}" Text="{Binding NotSent}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="Decoder can't keep up" /><TextBlock Style="{StaticResource MetricValue}" Text="{Binding DecoderOverruns}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="Not gated" /><TextBlock Style="{StaticResource MetricValue}" Text="{Binding NotGated}" /></StackPanel></Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                               Text="Counted from log lines since this program started (or the last reset); they are what Dire Wolf printed, not a measurement by this program." />
                    <Grid Height="280">
                        <ListBox ItemsSource="{Binding LogLines}" FontSize="12" VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="WAPR log lines">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WaprLogLine}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, Converter={StaticResource LocalTime}}" Width="70" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Text}" Foreground="{Binding Brush, Converter={StaticResource ThemeBrush}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="No WAPR lines yet (Dire Wolf not running, or no WAPR channel configured)."
                                   Visibility="{Binding LogLines.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
