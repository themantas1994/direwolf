<UserControl x:Class="DireWolfGui.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DireWolfGui.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Packet terminal" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Connected-mode AX.25 (keyboard-to-keyboard, BBS, nodes) through Dire Wolf. Connecting and sending transmit on the air." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource InfoBanner}">
            <TextBlock Style="{StaticResource Body}">
                <Run Text="Connected mode needs Dire Wolf's AGW interface (AGWPORT, default 8000). KISS alone does not provide connected-mode control in this application. This page uses its own AGW connection to" />
                <Run Text="{Binding TncEndpointText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=", separate from the packet monitor." />
            </TextBlock>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TNC connection -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                    <Border Style="{StaticResource Pill}" Background="{Binding StateKind, Converter={StaticResource ThemeBrush}}" Margin="0,0,10,4"
                            AutomationProperties.Name="Terminal state">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding StateText}" />
                    </Border>
                    <Button Command="{Binding ConnectTncCommand}" Padding="10,4" Margin="0,0,6,4"
                            ToolTip="Open a connection to Dire Wolf's AGW interface (does not transmit)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE703;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Connect to TNC" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DisconnectTncCommand}" Padding="10,4" Margin="0,0,16,4" Content="Disconnect TNC" />
                    <TextBlock Text="{Binding OutstandingText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,4" />
                </WrapPanel>

                <!-- Station connection -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="My call" Style="{StaticResource FormLabel}" Margin="0,4,6,4" />
                    <TextBox Width="100" Margin="0,0,12,4" Text="{Binding MyCall, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"
                             AutomationProperties.Name="My callsign" />
                    <TextBlock Text="Connect to" Style="{StaticResource FormLabel}" Margin="0,4,6,4" />
                    <TextBox Width="100" Margin="0,0,12,4" Text="{Binding RemoteCall, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"
                             AutomationProperties.Name="Remote callsign" />
                    <TextBlock Text="Via" Style="{StaticResource FormLabel}" Margin="0,4,6,4" />
                    <TextBox Width="140" Margin="0,0,12,4" Text="{Binding Via, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"
                             AutomationProperties.Name="Via digipeaters" ToolTip="Optional digipeaters, comma separated (up to 7)" />
                    <TextBlock Text="Port" Style="{StaticResource FormLabel}" Margin="0,4,6,4" />
                    <ComboBox Width="200" Margin="0,0,12,4" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                              DisplayMemberPath="Label" AutomationProperties.Name="Radio port" />
                    <Button Command="{Binding ConnectCommand}" Padding="12,4" Margin="0,0,6,4" ToolTip="Call the station (transmits)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE717;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Connect" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DisconnectCommand}" Padding="12,4" Margin="0,0,6,4" Content="Disconnect" />
                </WrapPanel>

                <DockPanel Grid.Row="2" Margin="0,0,0,4" LastChildFill="False">
                    <CheckBox DockPanel.Dock="Left" Content="Auto-scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Command="{Binding ClearCommand}" Padding="8,3" Content="Clear" />
                    <Button DockPanel.Dock="Right" Command="{Binding SaveTranscriptCommand}" Padding="8,3" Margin="0,0,6,0" Content="Save transcript…" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Margin="16,0,0,0" VerticalAlignment="Center"
                               Text="Received text, your sent lines (&gt;) and notices are shown in different colours." />
                </DockPanel>

                <!-- Output -->
                <ListBox x:Name="Output" Grid.Row="3" ItemsSource="{Binding Lines}" SelectionMode="Extended"
                         Background="{DynamicResource CodeBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Terminal output">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TerminalLine}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                       Foreground="{Binding BrushKind, Converter={StaticResource ThemeBrush}}">
                                <Run Text="{Binding Prefix, Mode=OneWay}" /><Run Text="{Binding Text, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Input -->
                <DockPanel Grid.Row="4" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Command="{Binding SendCommand}" Padding="14,4" Margin="6,0,0,0"
                            ToolTip="Send the line (Enter). Up/Down recall earlier lines.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE724;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Send" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                             AutomationProperties.Name="Line to send. Enter sends, Up and Down recall history.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize ports panel" />

            <!-- Ports & capabilities -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshPortsCommand}" Padding="6,2"
                                    ToolTip="Ask Dire Wolf for its ports again" AutomationProperties.Name="Refresh ports">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="12" />
                            </Button>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Ports &amp; capabilities" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Connect to the TNC to see Dire Wolf's radio ports."
                                   Visibility="{Binding IsTncConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" Margin="0,0,0,8"
                                   Visibility="{Binding VersionText, Converter={StaticResource NotEmptyToVis}}" />
                        <ItemsControl ItemsSource="{Binding Ports}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AgwPortChoice}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Selected port" Margin="0,10,0,4"
                                   Visibility="{Binding CapabilitiesText, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding CapabilitiesText}" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{Binding CapabilitiesText, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="Values as reported by Dire Wolf's AGW 'g' reply. Radio ports correspond to Dire Wolf's channels." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
