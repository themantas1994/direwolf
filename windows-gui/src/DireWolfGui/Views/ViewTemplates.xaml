<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DireWolfGui.ViewModels"
                    xmlns:v="clr-namespace:DireWolfGui.Views">
    <!-- Maps each page view model to its view. -->
    <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
        <v:MonitorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AprsViewModel}">
        <v:AprsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MessagesViewModel}">
        <v:MessagesView />
    </DataTemplate>
</ResourceDictionary>
