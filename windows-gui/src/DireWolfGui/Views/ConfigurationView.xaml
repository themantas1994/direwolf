<UserControl x:Class="DireWolfGui.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DireWolfGui.ViewModels">
    <UserControl.Resources>
        <!-- One guided directive: value editor, Apply / Disable, catalog help. -->
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type vm:GuidedField}">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Label}" Margin="0,0,12,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding StateText}" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                         Visibility="{Binding HasNoChoices, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.Name="{Binding Label}" />
                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Choices}" VerticalAlignment="Center"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.Name="{Binding Label}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Write this value into the configuration in the editor (not saved to disk until you press Save)" />
                    <Button Content="Disable" Command="{Binding DisableCommand}" Padding="10,4"
                            ToolTip="Comment out the line (it is kept and can be enabled again); Dire Wolf then uses its default" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                               Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Explanation}"
                               Visibility="{Binding Explanation, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Help}" FontStyle="Italic" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DefaultText}"
                               Visibility="{Binding DefaultText, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Syntax}" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Configuration" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Session.DisplayPath}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Command="{Binding OpenCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="Open another configuration file and make it the one Dire Wolf uses">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Open…" />
                </StackPanel>
            </Button>
            <Button Command="{Binding NewCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="Create a new configuration with the Setup wizard">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="New from template…" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="Review the changes, back up the file and save it">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Save…" />
                </StackPanel>
            </Button>
            <Button Command="{Binding RevertCommand}" Padding="10,4" Margin="0,0,6,6" ToolTip="Discard unsaved changes">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Revert" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ReloadCommand}" Content="Reload from disk" Padding="10,4" Margin="0,0,6,6" />
            <Button Command="{Binding OpenFolderCommand}" Content="Open folder" Padding="10,4" Margin="0,0,12,6" />
            <Border Style="{StaticResource Pill}" Background="{DynamicResource WarningBrush}" Margin="0,0,0,6"
                    Visibility="{Binding Session.IsDirty, Converter={StaticResource BoolToVis}}"
                    ToolTip="The editor has changes that are not saved to the file yet">
                <TextBlock Style="{StaticResource PillText}" Text="Unsaved changes" />
            </Border>
        </WrapPanel>

        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding NoDocument, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding NoDocumentText}" />
            </Border>
            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Session.IsStale, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding Session.StaleMessage}" />
            </Border>
        </StackPanel>

        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTab}">
            <!-- (a) Guided -->
            <TabItem Header="Guided" IsEnabled="{Binding HasDocument}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,8,0">
                    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                        <Border Style="{StaticResource InfoBanner}">
                            <TextBlock Style="{StaticResource Body}"
                                       Text="Common settings with explanations. Apply writes a value into the configuration in the editor; nothing reaches the file until you press Save and confirm the changes. Every other line, comment and setting in the file is kept." />
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Station identity" />
                                <ItemsControl ItemsSource="{Binding IdentityFields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshAudioCommand}" Content="Refresh device list" Padding="10,4" />
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Audio devices" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Devices}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GuidedDevice}">
                                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Editor.Title}" Margin="0,0,0,4" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Editor.StateText}" Margin="0,0,0,6" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource FormLabel}" Text="Input (receive)" />
                                                        <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Editor.InputChoices}" Margin="0,2"
                                                                  Text="{Binding Editor.Input, UpdateSourceTrigger=PropertyChanged}"
                                                                  AutomationProperties.Name="Audio input device" ToolTip="{Binding Editor.InputList}" />
                                                        <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Output (transmit)" />
                                                        <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Editor.OutputChoices}" Margin="0,2"
                                                                  Text="{Binding Editor.Output, UpdateSourceTrigger=PropertyChanged}"
                                                                  AutomationProperties.Name="Audio output device" ToolTip="{Binding Editor.OutputList}" />
                                                        <Button Grid.RowSpan="2" Grid.Column="2" Content="Apply" Command="{Binding Editor.ApplyCommand}" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,8">
                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Editor.Help}" />
                                                            <TextBlock Style="{StaticResource Caption}" Text="Windows input devices:" Margin="0,4,0,0" FontWeight="SemiBold" />
                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Editor.InputList}" FontFamily="{StaticResource MonoFont}" />
                                                            <TextBlock Style="{StaticResource Caption}" Text="Windows output devices:" Margin="0,4,0,0" FontWeight="SemiBold" />
                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Editor.OutputList}" FontFamily="{StaticResource MonoFont}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button HorizontalAlignment="Left" Command="{Binding AddDeviceCommand}" Content="{Binding AddDeviceText}" Padding="10,4" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Radio channels" />
                                <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GuidedChannel}">
                                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14" Text="{Binding Title}" Margin="0,0,0,6" />
                                                    <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Note, Converter={StaticResource NotEmptyToVis}}">
                                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Note}" />
                                                    </Border>
                                                    <!-- PTT -->
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource FormLabel}" Text="Transmitter keying (PTT)" TextWrapping="Wrap" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Ptt.MethodList}" SelectedIndex="{Binding Ptt.Method}"
                                                                  AutomationProperties.Name="PTT method" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="Apply" Command="{Binding Ptt.ApplyCommand}" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding Ptt.IsSerial, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource FormLabel}" Text="Port" />
                                                                <ComboBox IsEditable="True" ItemsSource="{Binding Ptt.Ports}" Text="{Binding Ptt.Port, UpdateSourceTrigger=PropertyChanged}"
                                                                          Width="110" AutomationProperties.Name="Serial port" Margin="0,0,12,0" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding Ptt.IsCm108, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource FormLabel}" Text="GPIO" />
                                                                <TextBox Text="{Binding Ptt.Gpio, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0"
                                                                         AutomationProperties.Name="CM108 GPIO number" ToolTip="Empty = 3, the usual pin" />
                                                                <TextBlock Style="{StaticResource FormLabel}" Text="HID device (optional)" />
                                                                <TextBox Text="{Binding Ptt.HidPath, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,12,0"
                                                                         AutomationProperties.Name="CM108 HID device path" />
                                                            </StackPanel>
                                                            <CheckBox Content="Inverted (active low)" IsChecked="{Binding Ptt.Invert}" Margin="0,4,12,0"
                                                                      Visibility="{Binding Ptt.IsOther, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding Ptt.IsOther, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource FormLabel}" Text="PTT" />
                                                                <TextBox Text="{Binding Ptt.Other, UpdateSourceTrigger=PropertyChanged}" Width="300" FontFamily="{StaticResource MonoFont}"
                                                                         AutomationProperties.Name="PTT arguments" />
                                                            </StackPanel>
                                                        </WrapPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Ptt.StateText}" />
                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Ptt.Preview, StringFormat='After Apply: {0}'}" FontFamily="{StaticResource MonoFont}" />
                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Ptt.Help}" FontStyle="Italic" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Add channel" />
                                    <ComboBox ItemsSource="{Binding AvailableNewChannels}" SelectedItem="{Binding SelectedNewChannel}" Width="80"
                                              AutomationProperties.Name="Channel to add" Margin="0,0,8,0" />
                                    <Button Content="Add (MODEM 1200, no PTT)" Command="{Binding AddChannelCommand}" Padding="10,4" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="Only channels whose audio device exists can be added: channel 2n and, with ACHANNELS 2 (stereo), 2n+1 for audio device n." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Network (client applications)" />
                                <Border Style="{StaticResource WarningBanner}">
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding TcpBindWarning}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding NetworkFields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="KISS over TCP ports (KISSPORT)" Margin="0,4,0,4" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding KissDefaultNote}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding KissPorts}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:KissPortRow}">
                                            <StackPanel Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding LineNumber, StringFormat='Line {0}: port'}" />
                                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80" AutomationProperties.Name="KISS port" />
                                                    <TextBlock Style="{StaticResource FormLabel}" Text="channel (empty = all)" Margin="12,4,8,4" />
                                                    <TextBox Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="KISS channel" />
                                                    <Button Content="Apply" Margin="8,0,6,0" Padding="10,4"
                                                            Command="{Binding DataContext.ApplyKissPortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Content="Disable" Padding="10,4"
                                                            Command="{Binding DataContext.DisableKissPortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="New KISS port" />
                                    <TextBox Text="{Binding NewKissPort, UpdateSourceTrigger=PropertyChanged}" Width="80" AutomationProperties.Name="New KISS port" />
                                    <TextBlock Style="{StaticResource FormLabel}" Text="channel (empty = all)" Margin="12,4,8,4" />
                                    <TextBox Text="{Binding NewKissChannel, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="New KISS port channel" />
                                    <Button Content="Add" Command="{Binding AddKissPortCommand}" Margin="8,0,0,0" Padding="10,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Logging" />
                                <ItemsControl ItemsSource="{Binding LoggingFields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="GPS" />
                                <ItemsControl ItemsSource="{Binding GpsFields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                   Text="Beacons, digipeating and the IGate are on the Gateway &amp; digipeater page; WAPR on the WAPR (experimental) page; everything else on the All directives and Raw text tabs." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- (b) All directives -->
            <TabItem Header="All directives" IsEnabled="{Binding HasDocument}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FormLabel}" Text="Search" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="240" Margin="0,0,12,0"
                                 AutomationProperties.Name="Search directives" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Show" />
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" Width="230" Margin="0,0,12,0"
                                  AutomationProperties.Name="Directive filter" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DirectiveCountText}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DirectiveRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                              EnableRowVirtualization="True" AutomationProperties.Name="Configuration directives">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="55" />
                            <DataGridTextColumn Header="Directive" Binding="{Binding Keyword}" Width="110" />
                            <DataGridTextColumn Header="Context" Binding="{Binding ContextText}" Width="85" />
                            <DataGridTemplateColumn Header="Line text" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Flags}" Width="110" />
                            <DataGridTemplateColumn Header="Problems" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{Binding SeverityKind, Converter={StaticResource ThemeBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Description" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Disable" Padding="8,2" Margin="0,0,4,0"
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.DisableLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Enable" Padding="8,2" Margin="0,0,4,0"
                                                    Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.EnableLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Show in text" Padding="8,2"
                                                    Command="{Binding DataContext.ShowInTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- (c) Raw text -->
            <TabItem Header="Raw text" IsEnabled="{Binding HasDocument}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,8" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Apply text" Command="{Binding ApplyRawCommand}" Padding="10,4" Margin="0,0,6,0"
                                ToolTip="Re-read the text into the editor (still not saved to disk until you press Save)" />
                        <Button DockPanel.Dock="Left" Content="Discard text edits" Command="{Binding DiscardRawCommand}" Padding="10,4" Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Left" Content="Check text" Command="{Binding ValidateRawCommand}" Padding="10,4" Margin="0,0,12,0" />
                        <TextBlock DockPanel.Dock="Left" x:Name="CaretText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                        <Border Style="{StaticResource WarningBanner}" Visibility="{Binding RawConflict, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Body}" Text="The configuration was changed elsewhere after you started editing this text. Apply text replaces those changes; Discard text edits shows the current configuration." />
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="APRS-IS passcodes are shown as *****. Leave ***** on an IGLOGIN line to keep the passcode that is in the file, or type a new one. Dire Wolf does not allow a # comment after a setting on the same line." />
                    </StackPanel>
                    <TextBox x:Name="RawEditor" Grid.Row="2" Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalContentAlignment="Top"
                             SelectionChanged="RawEditor_SelectionChanged" AutomationProperties.Name="Configuration text" />
                    <GridSplitter Grid.Row="2" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext" />
                    <DockPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Body}" FontWeight="SemiBold" Text="Problems in the text (select one to go to its line)" Margin="0,0,0,6" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="No problems found."
                                   Visibility="{Binding RawDiagnostics.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                        <ListBox ItemsSource="{Binding RawDiagnostics}" SelectedItem="{Binding SelectedRawDiagnostic}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Problems in the text">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiagnosticRow}">
                                    <StackPanel Margin="0,2">
                                        <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="{Binding Kind, Converter={StaticResource ThemeBrush}}">
                                            <Run Text="{Binding Severity, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LineText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Body}" FontSize="12" Text="{Binding Message}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- (d) Diagnostics -->
            <TabItem Header="Diagnostics" IsEnabled="{Binding HasDocument}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Show selected in text" Padding="10,4"
                                Command="{Binding ShowInTextCommand}" CommandParameter="{Binding SelectedDiagnostic}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Dire Wolf Station's checks" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DiagnosticsSummary}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding GuiDiagnostics}" SelectedItem="{Binding SelectedDiagnostic}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              SelectionMode="Single" AutomationProperties.Name="Diagnostics from Dire Wolf Station">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="{Binding Kind, Converter={StaticResource ThemeBrush}}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineText}" Width="70" />
                            <DataGridTemplateColumn Header="Message" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                    <StackPanel Grid.Row="3" Margin="0,6,0,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CheckCommand}" Padding="10,4"
                                    ToolTip="Run direwolf --check-config: reads the configuration, opens no audio device, PTT or network port">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9D5;" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Check with Dire Wolf" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Dire Wolf's own parser" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding CheckStatus}" Foreground="{Binding CheckStatusKind, Converter={StaticResource ThemeBrush}}" Margin="0,4,0,4" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding CheckSummaryText}" Visibility="{Binding CheckSummaryText, Converter={StaticResource NotEmptyToVis}}" />
                        <ItemsControl ItemsSource="{Binding CheckNotes}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding CheckDiagnostics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" AutomationProperties.Name="Diagnostics from Dire Wolf">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Severity" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="{Binding Kind, Converter={StaticResource ThemeBrush}}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Line" Binding="{Binding LineText}" Width="70" />
                                <DataGridTemplateColumn Header="Message from Dire Wolf" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Expander Grid.Row="1" Header="Complete output (passcodes masked)" Margin="0,6,0,0">
                            <TextBox Text="{Binding CheckRawOutput, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     MaxHeight="220" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Complete check output" />
                        </Expander>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- (e) Backups -->
            <TabItem Header="Backups" IsEnabled="{Binding HasDocument}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Refresh" Command="{Binding RefreshBackupsCommand}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Compare with editor" Command="{Binding ViewBackupCommand}" CommandParameter="{Binding SelectedBackup}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Restore…" Command="{Binding RestoreBackupCommand}" CommandParameter="{Binding SelectedBackup}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Open backups folder" Command="{Binding OpenBackupFolderCommand}" Padding="10,4" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding BackupsNote}" Margin="0,0,0,8" />
                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" AutomationProperties.Name="Backups">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Made" Binding="{Binding When}" Width="170" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="No backups of this file yet. A backup is made every time the file is saved or restored here."
                                   Visibility="{Binding Backups.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- (f) Profiles -->
            <TabItem Header="Profiles">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Save editor as profile…" Command="{Binding SaveAsProfileCommand}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Open (use this configuration)" Command="{Binding OpenProfileCommand}" CommandParameter="{Binding SelectedProfile}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Duplicate…" Command="{Binding DuplicateProfileCommand}" CommandParameter="{Binding SelectedProfile}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Rename…" Command="{Binding RenameProfileCommand}" CommandParameter="{Binding SelectedProfile}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Import…" Command="{Binding ImportProfileCommand}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Export…" Command="{Binding ExportProfileCommand}" CommandParameter="{Binding SelectedProfile}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Delete…" Command="{Binding DeleteProfileCommand}" CommandParameter="{Binding SelectedProfile}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Refresh" Command="{Binding RefreshProfilesCommand}" Padding="10,4" Margin="0,0,6,6" />
                        <Button Content="Open profiles folder" Command="{Binding OpenProfilesFolderCommand}" Padding="10,4" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding ProfilesNote}" Margin="0,0,0,8" />
                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" AutomationProperties.Name="Profiles">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridCheckBoxColumn Header="In use" Binding="{Binding IsCurrent, Mode=OneWay}" Width="70" />
                                <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="150" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Text="No profiles yet. Save the configuration in the editor as a profile, or import a .conf file."
                                   Visibility="{Binding Profiles.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
