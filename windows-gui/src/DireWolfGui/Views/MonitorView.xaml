<UserControl x:Class="DireWolfGui.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DireWolfGui.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Packet monitor" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Every packet Dire Wolf reports: received over the radio, transmitted by this station, and IGate / network traffic. Each row says where the packet came from." />
        </StackPanel>

        <!-- Per-channel counters -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}" Focusable="False" Margin="0,0,0,6"
                      AutomationProperties.Name="Channel activity">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChannelStripItem}">
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Counts}" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Audio}" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LastHeard}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
            <Button Command="{Binding PauseCommand}" Margin="0,0,6,4" Padding="10,4"
                    ToolTip="Pause the list. Packets keep being received and are shown when you resume.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="{Binding PauseGlyph}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding PauseButtonText}" />
                </StackPanel>
            </Button>
            <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="4,0,12,4"
                      ToolTip="Keep the newest packet in view" />
            <Button Command="{Binding JumpToLatestCommand}" Margin="0,0,6,4" Padding="10,4" ToolTip="Scroll to the newest packet">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74B;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Latest" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearCommand}" Margin="0,0,6,4" Padding="10,4"
                    ToolTip="Clear this list (does not delete anything Dire Wolf logged)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Clear view" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CopyRowsCommand}" CommandParameter="{Binding SelectedItems, ElementName=PacketGrid}"
                    Margin="12,0,6,4" Padding="10,4" ToolTip="Copy the selected rows as text (Ctrl+C)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Copy rows" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportVisibleCommand}" Margin="0,0,6,4" Padding="10,4"
                    ToolTip="Save all rows shown (after filters) as CSV or plain text">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xEDE1;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Export shown…" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=PacketGrid}"
                    Margin="0,0,6,4" Padding="10,4" ToolTip="Save the selected rows as CSV or plain text">
                <TextBlock Text="Export selected…" />
            </Button>
        </WrapPanel>

        <!-- Filters -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,4">
            <TextBlock Text="Search" Style="{StaticResource FormLabel}" Margin="0,4,6,4" />
            <TextBox Width="180" Margin="0,0,12,4" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     AutomationProperties.Name="Search source, destination, path and info"
                     ToolTip="Matches source, destination, path and info text" />
            <TextBlock Text="Callsign" Style="{StaticResource FormLabel}" Margin="0,4,6,4" />
            <TextBox Width="110" Margin="0,0,12,4" Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     AutomationProperties.Name="Callsign filter" CharacterCasing="Upper"
                     ToolTip="Source, destination, heard station, path or addressee. Without an SSID every SSID matches." />
            <ComboBox Width="160" Margin="0,0,8,4" ItemsSource="{Binding ChannelChoices}" SelectedItem="{Binding SelectedChannel}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Channel filter" />
            <ComboBox Width="210" Margin="0,0,8,4" ItemsSource="{Binding OriginChoices}" SelectedItem="{Binding SelectedOrigin}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Direction and origin filter" />
            <ComboBox Width="200" Margin="0,0,8,4" ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedType}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Packet type filter" />
            <CheckBox Content="WAPR only" IsChecked="{Binding WaprOnly}" VerticalAlignment="Center" Margin="4,0,12,4" />
            <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Padding="10,4" Margin="0,0,0,4" />
        </WrapPanel>

        <DockPanel Grid.Row="4" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding CountText}" Margin="0,0,16,0" />
            <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Background="{DynamicResource WarningBrush}"
                    Visibility="{Binding PendingText, Converter={StaticResource NotEmptyToVis}}">
                <TextBlock Style="{StaticResource PillText}" Text="{Binding PendingText}" TextWrapping="Wrap" />
            </Border>
        </DockPanel>

        <!-- List and detail -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="PacketGrid" Grid.Column="0" ItemsSource="{Binding Packets}" SelectedItem="{Binding SelectedPacket}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeight="26"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item" ScrollViewer.IsDeferredScrollingEnabled="False"
                      AutomationProperties.Name="Packets">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy packet" Command="{Binding CopyPacketCommand}" />
                        <MenuItem Header="Copy source callsign" Command="{Binding CopyCallsignCommand}" />
                        <MenuItem Header="Copy selected rows" Command="{Binding CopyRowsCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Export selected rows…" Command="{Binding ExportSelectedCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Export all shown rows…" Command="{Binding ExportVisibleCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText, Mode=OneTime}" Width="72" />
                    <DataGridTextColumn Header="Ch" Binding="{Binding ChannelText, Mode=OneTime}" Width="52" />
                    <DataGridTemplateColumn Header="Origin" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:PacketItemViewModel}">
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" ToolTip="{Binding OriginToolTip, Mode=OneTime}"
                                        Background="{Binding OriginKind, Mode=OneTime, Converter={StaticResource ThemeBrush}}">
                                    <TextBlock Style="{StaticResource PillText}" Text="{Binding OriginText, Mode=OneTime}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source, Mode=OneTime}" Width="95" />
                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination, Mode=OneTime}" Width="85" />
                    <DataGridTextColumn Header="Path" Binding="{Binding PathText, Mode=OneTime}" Width="130" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeText, Mode=OneTime}" Width="110" />
                    <DataGridTextColumn Header="Audio" Binding="{Binding AudioText, Mode=OneTime}" Width="80" />
                    <DataGridTextColumn Header="FEC / WAPR" Binding="{Binding FecText, Mode=OneTime}" Width="80" />
                    <DataGridTextColumn Header="Info" Binding="{Binding InfoText, Mode=OneTime}" Width="*" MinWidth="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Column="0" Text="{Binding EmptyText}" Style="{StaticResource Body}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" IsHitTestVisible="False"
                       Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVis}}" />

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          AutomationProperties.Name="Resize packet detail" />

            <!-- Detail -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <TextBlock Text="Select a packet to see its details, Dire Wolf's decode and the raw frame."
                               Style="{StaticResource Caption}" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Command="{Binding CopyPacketCommand}" Padding="8,3" Margin="0,0,6,0" Content="Copy packet" />
                                    <Button Command="{Binding CopyCallsignCommand}" Padding="8,3" Content="Copy callsign" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Packet" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Text="{Binding DetailSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFont}" Background="{DynamicResource CodeBackgroundBrush}"
                                     BorderThickness="0" Padding="6" AutomationProperties.Name="Packet fields" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Dire Wolf's decode" Margin="0,12,0,4" />
                            <TextBox Text="{Binding DetailDecoded, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFont}" Background="{DynamicResource CodeBackgroundBrush}"
                                     BorderThickness="0" Padding="6" AutomationProperties.Name="Dire Wolf decode lines" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="APRS (parsed by this application)" Margin="0,12,0,4" />
                            <TextBox Text="{Binding DetailAprs, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFont}" Background="{DynamicResource CodeBackgroundBrush}"
                                     BorderThickness="0" Padding="6" AutomationProperties.Name="APRS parse" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Console line" Margin="0,12,0,4" />
                            <TextBox Text="{Binding DetailRaw, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFont}" Background="{DynamicResource CodeBackgroundBrush}"
                                     BorderThickness="0" Padding="6" AutomationProperties.Name="Raw console text" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Raw AX.25 frame" Margin="0,12,0,4" />
                            <TextBox Text="{Binding DetailHex, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}" Background="{DynamicResource CodeBackgroundBrush}"
                                     BorderThickness="0" Padding="6" AutomationProperties.Name="Raw frame hex dump" />
                            <TextBox Text="{Binding DetailAx25, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0"
                                     FontFamily="{StaticResource MonoFont}" Background="{DynamicResource CodeBackgroundBrush}"
                                     BorderThickness="0" Padding="6" AutomationProperties.Name="AX.25 decode"
                                     Visibility="{Binding DetailAx25, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
