<UserControl x:Class="DireWolfGui.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DireWolfGui.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Gateway &amp; digipeater" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="What your configuration makes the station transmit or forward, and editors for the digipeater, IGate, beacons and filters. Every change asks for confirmation and is only written after you review it with Save." />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding NoDocument, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Go to Configuration" Command="{Binding OpenConfigurationCommand}" Padding="10,4" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding NoDocumentText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Session.IsStale, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding Session.StaleMessage}" />
            </Border>
            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Session.IsDirty, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Review and save…" Command="{Binding SaveCommand}" Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="Discard" Command="{Binding RevertCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                               Text="The configuration has unsaved changes (from this page or the Configuration page). Nothing changes for Dire Wolf until you save and restart it." />
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2">
            <!-- Overview -->
            <TabItem Header="What transmits" IsEnabled="{Binding HasDocument}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ReportSummary}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiagnosticRow}">
                                    <Border Style="{StaticResource WarningBanner}">
                                        <TextBlock Style="{StaticResource Body}">
                                            <Run Text="{Binding LineText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Services}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ServiceCard}">
                                    <Border Style="{StaticResource Card}" Width="330">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Style="{StaticResource Pill}" Background="{Binding BadgeKind, Converter={StaticResource ThemeBrush}}">
                                                    <TextBlock Style="{StaticResource PillText}" Text="{Binding Badge}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding LineText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" Margin="0,0,0,4" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Explanation}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12"
                                   Text="Based on the configuration in the editor (and, when it is saved, on Dire Wolf's own --check-config summary). It describes what the settings allow; it does not watch the radio." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Digipeater -->
            <TabItem Header="Digipeater" IsEnabled="{Binding HasDocument}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="DIGIPEAT rules" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="No rules: the station does not digipeat."
                                   Visibility="{Binding DigiRows.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                        <ListBox x:Name="DigiList" ItemsSource="{Binding DigiRows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Digipeater rules">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ServiceLineRow}">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding LineNumber, StringFormat='Line {0}', Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Edit selected" Command="{Binding EditDigiCommand}" CommandParameter="{Binding SelectedItem, ElementName=DigiList}" Padding="10,4" Margin="0,0,6,6" />
                                <Button Content="Disable selected" Command="{Binding DisableRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=DigiList}" Padding="10,4" Margin="0,0,6,6" />
                                <Button Content="Enable selected…" Command="{Binding EnableRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=DigiList}" Padding="10,4" Margin="0,0,6,6" />
                                <Button Content="New rule" Command="{Binding NewDigiCommand}" Padding="10,4" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding DigiFormTitle}" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Preset: standard WIDEn-N" Command="{Binding PresetStandardCommand}" Padding="10,4" Margin="0,0,6,6" />
                                <Button Content="Preset: fill-in (WIDE1-1 only)" Command="{Binding PresetFillInCommand}" Padding="10,4" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding PresetNote}" Margin="0,0,0,8" Visibility="{Binding PresetNote, Converter={StaticResource NotEmptyToVis}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="Heard on channel" />
                                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding RadioChannels}" Text="{Binding DigiFrom, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Heard on channel" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Repeated on channel" />
                                <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" ItemsSource="{Binding RadioChannels}" Text="{Binding DigiTo, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Repeated on channel" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Alias pattern" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DigiAlias, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Margin="0,2" AutomationProperties.Name="Alias pattern" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="WIDEn-N pattern" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DigiWide, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Margin="0,2" AutomationProperties.Name="WIDEn-N pattern" />
                                <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Option" />
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DigiOptions}" SelectedItem="{Binding DigiOption}" Width="120" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Preemptive option" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DigiPreview}" Margin="0,8,0,8" />
                            <Button Content="Apply rule…" Command="{Binding SaveDigiCommand}" HorizontalAlignment="Left" Padding="10,4" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- IGate -->
            <TabItem Header="IGate" IsEnabled="{Binding HasDocument}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding IgateState}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Radio → Internet (APRS-IS)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Server (IGSERVER)" />
                                    <TextBox Grid.Column="1" Text="{Binding IgServer, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" AutomationProperties.Name="APRS-IS server" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Login callsign" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IgLoginCall, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="APRS-IS login callsign" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Passcode" />
                                    <PasswordBox x:Name="PasscodeBox" Grid.Row="2" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,2"
                                                 AutomationProperties.Name="APRS-IS passcode" ToolTip="Leave empty to keep the passcode that is already in the file" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding PasscodeState}" Margin="0,2,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" TextWrapping="Wrap"
                                           Text="The passcode is written only into the Dire Wolf configuration file (Dire Wolf reads it from there). Dire Wolf Station never stores it in its settings, never logs it and shows it as ***** everywhere. Leave the box empty to keep the current passcode." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Apply IGate…" Click="ApplyIGate_Click" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Content="Turn IGate off" Command="{Binding DisableIGateCommand}" Padding="10,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Internet → radio (IGTXVIA) — transmits" />
                                <Border Style="{StaticResource ErrorBanner}">
                                    <TextBlock Style="{StaticResource Body}"
                                               Text="With IGTXVIA your transmitter sends traffic that arrives from the Internet, unattended. Only enable it if you understand what will be sent and it is allowed under your licence (third-party traffic rules differ between countries)." />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Channel" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding RadioChannels}" Text="{Binding IgTxChannel, UpdateSourceTrigger=PropertyChanged}" Width="80" AutomationProperties.Name="Internet to radio channel" />
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Via path" Margin="16,4,8,4" />
                                    <TextBox Text="{Binding IgTxVia, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="Internet to radio via path" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Turn on Internet → radio…" Command="{Binding ApplyTxViaCommand}" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Content="Turn off" Command="{Binding DisableTxViaCommand}" Padding="10,4" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="IGTXLIMIT: per minute" />
                                    <TextBox Text="{Binding IgTxLimit1, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="Transmit limit per minute" />
                                    <TextBlock Style="{StaticResource FormLabel}" Text="per 5 minutes" Margin="12,4,8,4" />
                                    <TextBox Text="{Binding IgTxLimit5, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="Transmit limit per five minutes" />
                                    <Button Content="Apply" Command="{Binding ApplyIgTxLimitCommand}" Padding="10,4" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Limits how many packets per 1 and 5 minutes go from the Internet to the radio. Empty uses Dire Wolf's default." Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Server-side filter (IGFILTER)" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding IgFilter, UpdateSourceTrigger=PropertyChanged}" Width="320" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="IGate server filter" />
                                    <Button Content="Apply" Command="{Binding ApplyIgFilterCommand}" Padding="10,4" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Asks APRS-IS for additional traffic, e.g. m/50 (within 50 km). Empty and Apply disables the line. With Internet → radio enabled, more traffic may be transmitted." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Beacons -->
            <TabItem Header="Beacons" IsEnabled="{Binding HasDocument}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="Beacons" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="No beacons: the station does not transmit anything on its own."
                                   Visibility="{Binding Beacons.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                        <ListBox x:Name="BeaconList" ItemsSource="{Binding Beacons}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Beacons">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BeaconRow}">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="To " /><Run Text="{Binding Where, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Timing, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Via, StringFormat='via {0}'}" Visibility="{Binding Via, Converter={StaticResource NotEmptyToVis}}" />
                                        <TextBlock Style="{StaticResource Mono}" FontSize="12" Text="{Binding OptionsText}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Warning}" Foreground="{DynamicResource WarningBrush}"
                                                   Visibility="{Binding Warning, Converter={StaticResource NotEmptyToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Edit selected" Command="{Binding EditBeaconCommand}" CommandParameter="{Binding SelectedItem, ElementName=BeaconList}" Padding="10,4" Margin="0,0,6,6" />
                                <Button Content="Disable selected" Command="{Binding DisableBeaconCommand}" CommandParameter="{Binding SelectedItem, ElementName=BeaconList}" Padding="10,4" Margin="0,0,6,6" />
                                <Button Content="Enable selected…" Command="{Binding EnableBeaconCommand}" CommandParameter="{Binding SelectedItem, ElementName=BeaconList}" Padding="10,4" Margin="0,0,6,6" />
                                <Button Content="New beacon" Command="{Binding NewBeaconCommand}" Padding="10,4" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding BeaconFormTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="Type" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding BeaconKinds}" SelectedItem="{Binding BeaconKind}" Width="140" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Beacon type" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="every (minutes or m:ss)" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BeaconEvery, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Beacon interval" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="delay (first beacon)" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BeaconDelay, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Beacon delay" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="sendto (channel or IG)" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BeaconSendTo, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Beacon destination" />
                                <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="via (digipeater path)" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BeaconVia, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Beacon via path" />
                                <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Other options" VerticalAlignment="Top" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding BeaconOther, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="130"
                                         FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,2"
                                         AutomationProperties.Name="Other beacon options, one key=value per line" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,8" TextWrapping="Wrap"
                                       Text="One option per line, e.g. lat=42^37.14N, long=071^20.83W, symbol=/-, comment=text, objname=... (see the Dire Wolf User Guide). sendto=IG sends to APRS-IS instead of the radio. Every 10 minutes or more (30 for a fixed station) is the usual courtesy on shared APRS channels." />
                            <Button Content="Apply beacon…" Command="{Binding SaveBeaconCommand}" HorizontalAlignment="Left" Padding="10,4" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Filters -->
            <TabItem Header="Filters" IsEnabled="{Binding HasDocument}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="FILTER lines limit what is digipeated or IGated between channels (FILTER from to spec, IG for the IGate); CFILTER does the same for connected-mode digipeating. Edit them on the Configuration page (Raw text)." />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Disable selected" Command="{Binding DisableRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=FilterList}" Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="Enable selected…" Command="{Binding EnableRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=FilterList}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="No FILTER or CFILTER lines."
                               Visibility="{Binding FilterRows.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                    <ListBox x:Name="FilterList" ItemsSource="{Binding FilterRows}" AutomationProperties.Name="Filters">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ServiceLineRow}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Style="{StaticResource Caption}" Width="110">
                                        <Run Text="{Binding LineNumber, StringFormat='Line {0}', Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Mono}" Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Forwarding log -->
            <TabItem Header="Recent forwarding">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearEventsCommand}" Padding="10,4" />
                        <CheckBox DockPanel.Dock="Right" Content="Also show packets heard via other digipeaters" IsChecked="{Binding ShowHeardViaDigi}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Lines from Dire Wolf's output that show the station forwarding traffic ([rx>ig], [ig>tx], [ig], WAPR gate, high-priority [nH] transmissions), newest first. Observation only." />
                    </DockPanel>
                    <Grid>
                        <ListBox ItemsSource="{Binding Events}" FontSize="12" VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Recent forwarding">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ForwardingEvent}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, Converter={StaticResource LocalTime}}" Width="70" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                        <TextBlock Text="{Binding Kind}" Width="200" Foreground="{Binding KindBrush, Converter={StaticResource ThemeBrush}}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Nothing forwarded since this program started (or Dire Wolf is not running)."
                                   Visibility="{Binding Events.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
