<UserControl x:Class="DireWolfGui.Views.AprsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DireWolfGui.ViewModels"
             xmlns:ctl="clr-namespace:DireWolfGui.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="APRS map &amp; stations" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Stations and objects heard, with positions only from real decoded reports. Each position shows where it came from and how old it is; old positions are greyed as stale." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource InfoBanner}"
                Visibility="{Binding ShowCsvLogHint, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Body}"
                       Text="Dire Wolf's CSV log is not enabled, so positions come only from this application's own parsing of received packets. Enable the CSV log in Settings to also use the positions decoded by Dire Wolf itself (and keep a daily log file)." />
        </Border>

        <!-- Filters and actions -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,4">
            <TextBlock Text="Search" Style="{StaticResource FormLabel}" Margin="0,4,6,4" />
            <TextBox Width="160" Margin="0,0,10,4" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     AutomationProperties.Name="Search callsign, comment or status" />
            <ComboBox Width="150" Margin="0,0,8,4" ItemsSource="{Binding AgeChoices}" SelectedItem="{Binding SelectedAge}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Maximum age" />
            <ComboBox Width="140" Margin="0,0,8,4" ItemsSource="{Binding DistanceChoices}" SelectedItem="{Binding SelectedDistance}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Maximum distance" IsEnabled="{Binding HasHome}"
                      ToolTip="Needs your home position (Settings)" ToolTipService.ShowOnDisabled="True" />
            <ComboBox Width="160" Margin="0,0,8,4" ItemsSource="{Binding ChannelChoices}" SelectedItem="{Binding SelectedChannel}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Channel filter" />
            <ComboBox Width="170" Margin="0,0,8,4" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding SelectedKind}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Stations or objects" />
            <ComboBox Width="140" Margin="0,0,8,4" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Sort order" />
            <CheckBox Content="Has position" IsChecked="{Binding HasPositionOnly}" VerticalAlignment="Center" Margin="4,0,10,4" />
            <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Padding="10,4" Margin="0,0,0,4" />
        </WrapPanel>

        <DockPanel Grid.Row="3" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding CountText}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding ExportStationsCommand}" Padding="10,4" Margin="0,0,6,0" Content="Export stations (CSV)…"
                        ToolTip="Save the stations shown as CSV" />
                <Button Command="{Binding ExportGpxSelectedCommand}" Padding="10,4" Margin="0,0,6,0" Content="Selected track (GPX)…"
                        ToolTip="Save the selected station's real track points as GPX" />
                <Button Command="{Binding ExportGpxAllCommand}" Padding="10,4" Content="All tracks (GPX)…"
                        ToolTip="Save the real track points of all stations shown as GPX" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Station list -->
            <DataGrid x:Name="StationGrid" Grid.Column="0" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                      RowHeight="26" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Stations">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Callsign / object" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:StationItemViewModel}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding KindText}">
                                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE7C1;" Margin="0,0,4,0"
                                               Visibility="{Binding Station.IsObject, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.Name="Object" />
                                    <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Last heard" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:StationItemViewModel}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AgeText}" />
                                    <TextBlock Text=" (stale)" Foreground="{DynamicResource StaleBrush}"
                                               Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Distance" Binding="{Binding DistanceText}" Width="120" />
                    <DataGridTextColumn Header="Sym" Binding="{Binding Symbol}" Width="40" />
                    <DataGridTextColumn Header="Ch" Binding="{Binding ChannelText}" Width="36" />
                    <DataGridTemplateColumn Header="Origin" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:StationItemViewModel}">
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left"
                                        Background="{Binding OriginKind, Converter={StaticResource ThemeBrush}}"
                                        Visibility="{Binding OriginText, Converter={StaticResource NotEmptyToVis}}">
                                    <TextBlock Style="{StaticResource PillText}" Text="{Binding OriginText}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Position" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:StationItemViewModel}">
                                <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding PositionKind, Converter={StaticResource ThemeBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Pkts" Binding="{Binding PacketCount}" Width="50" />
                    <DataGridTextColumn Header="Comment / status" Binding="{Binding CommentText}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Column="0" Text="{Binding EmptyText}" Style="{StaticResource Body}" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" IsHitTestVisible="False"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVis}}" />

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize list and map" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="160" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                    <CheckBox Content="Tracks" IsChecked="{Binding ShowTracks}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Content="Labels" IsChecked="{Binding ShowLabels}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Button Command="{Binding FitAllCommand}" Padding="8,3" Margin="0,0,6,0" ToolTip="Zoom to show every station on the map">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Fit all" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CenterSelectedCommand}" Padding="8,3" ToolTip="Centre the map on the selected station">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE81D;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Go to selected" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4"
                        Background="{DynamicResource MapBackgroundBrush}">
                    <Grid>
                        <ctl:StationMap x:Name="Map" Markers="{Binding MapMarkers}" SelectedId="{Binding SelectedMapId, Mode=TwoWay}"
                                        CenterLatitude="{Binding MapCenterLatitude, Mode=TwoWay}"
                                        CenterLongitude="{Binding MapCenterLongitude, Mode=TwoWay}"
                                        Zoom="{Binding MapZoom, Mode=TwoWay}"
                                        TilesEnabled="{Binding TilesEnabled}" TileUrlTemplate="{Binding TileUrlTemplate}"
                                        Attribution="{Binding Attribution}" TileCacheDirectory="{Binding TileCacheDirectory}"
                                        HomeLatitude="{Binding HomeLatitude}" HomeLongitude="{Binding HomeLongitude}"
                                        ShowTracks="{Binding ShowTracks}" ShowLabels="{Binding ShowLabels}"
                                        AutomationProperties.Name="Station map. Arrow keys pan, plus and minus zoom." />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,6" Margin="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="320"
                                Visibility="{Binding MapEmptyText, Converter={StaticResource NotEmptyToVis}}">
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding MapEmptyText}" TextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize map and details" />

                <!-- Detail -->
                <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Select a station in the list or on the map."
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Command="{Binding SendMessageCommand}" Padding="10,4"
                                            ToolTip="Open APRS messages with this callsign filled in (nothing is sent until you press Send)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8BD;" FontSize="13" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding SendMessageText}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding SelectedStation.Callsign}" Margin="0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DetailRow}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                         BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                                         AutomationProperties.Name="{Binding Label}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Last packet" Margin="0,10,0,4" />
                                <TextBox Text="{Binding LastPacketText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="{StaticResource MonoFont}" Background="{DynamicResource CodeBackgroundBrush}"
                                         BorderThickness="0" Padding="6" AutomationProperties.Name="Last raw packet" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
