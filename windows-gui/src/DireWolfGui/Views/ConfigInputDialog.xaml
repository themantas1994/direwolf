<Window x:Class="DireWolfGui.Views.ConfigInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dire Wolf Station" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=InputBox}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Style="{StaticResource Body}" Margin="0,0,0,8" />
        <TextBox x:Name="InputBox" AutomationProperties.LabeledBy="{Binding ElementName=PromptText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" MinWidth="90" Padding="12,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" MinWidth="90" Padding="12,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
