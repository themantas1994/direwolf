<UserControl x:Class="DireWolfGui.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DireWolfGui.ViewModels"
             xmlns:core="clr-namespace:DireWolfGui.Core.Integrations;assembly=DireWolfGui.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Style="{StaticResource PageTitle}" Text="External programs" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="APRS clients, packet terminals and other programs that use Dire Wolf as their TNC over AGW (AGWPE) or KISS." />
        </StackPanel>
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource InfoBanner}">
            <TextBlock Style="{StaticResource Body}" Text="{Binding Disclaimer}" />
        </Border>

        <!-- Left: templates and saved programs -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="100" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="100" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Your programs" />
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" AutomationProperties.Name="Your programs">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExternalAppItem}">
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12"
                           Text="No programs yet. Pick one below and press Add."
                           Visibility="{Binding Apps.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
            </Grid>
            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
            <TextBlock Grid.Row="3" Style="{StaticResource SectionHeader}" Text="Known programs" />
            <Button Grid.Row="4" Content="Add the selected program" Command="{Binding AddFromTemplateCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,6" />
            <ListBox Grid.Row="5" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Known programs">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:ExternalAppTemplate}">
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Purpose}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <GridSplitter Grid.Row="2" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- Right: editor, guidance and ports -->
        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,0,8,0">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding CheckNowCommand}" Padding="10,4"
                                    ToolTip="Runs direwolf --check-config on the selected configuration (opens no audio, PTT or network)" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Dire Wolf's ports" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FormLabel}" Text="AGW (AGWPE) port" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding AgwText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="KISS TCP port(s)" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Text="{Binding KissText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Who can connect" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}" Text="{Binding BindText}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding PortsNote}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Visibility="{Binding HasSelectedApp, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding SelectedTemplate.Name}" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding SelectedTemplate.Purpose}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding SelectedTemplate.Caveat}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6"
                                   Visibility="{Binding SelectedTemplate.Caveat, Converter={StaticResource NotEmptyToVis}}" />
                        <ItemsControl ItemsSource="{Binding TemplateSteps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding StringFormat='• {0}'}" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" DataContext="{Binding SelectedApp}"
                        Visibility="{Binding DataContext.HasSelectedApp, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TemplateName, StringFormat='Template: {0}'}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Name" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" AutomationProperties.Name="Program name" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Program file" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" AutomationProperties.Name="Program file" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Padding="10,4" Margin="6,2,0,2"
                                    Command="{Binding DataContext.BrowseExeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Arguments (one per line)" VerticalAlignment="Top" TextWrapping="Wrap" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,2" AutomationProperties.Name="Program arguments, one per line" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Working folder" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" AutomationProperties.Name="Working folder" />
                            <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Padding="10,4" Margin="6,2,0,2"
                                    Command="{Binding DataContext.BrowseWorkDirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Connection" />
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DataContext.Protocols, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Protocol}" Width="160" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Connection protocol" />
                            <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Host" Visibility="{Binding IsTcp, Converter={StaticResource BoolToVis}}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,2"
                                     Visibility="{Binding IsTcp, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Host" />
                            <TextBlock Grid.Row="6" Style="{StaticResource FormLabel}" Text="Port (or serial speed)" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="Port or serial speed" />
                            <TextBlock Grid.Row="7" Style="{StaticResource FormLabel}" Text="Serial port" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SerialPort, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,2"
                                     Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Serial port" />
                            <TextBlock Grid.Row="8" Style="{StaticResource FormLabel}" Text="Notes" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" AutomationProperties.Name="Notes" />
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Save" Padding="10,4" Margin="0,0,6,6" Command="{Binding DataContext.SaveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="Discard edits" Padding="10,4" Margin="0,0,6,6" Command="{Binding DataContext.DiscardAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="Launch" Padding="10,4" Margin="0,0,6,6" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="Open folder" Padding="10,4" Margin="0,0,6,6" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="Test connection" Padding="10,4" Margin="0,0,6,6" Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Connects to Dire Wolf's AGW or KISS port as this program would; nothing is transmitted" />
                            <Button Content="Remove…" Padding="10,4" Margin="0,0,6,6" Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Result}" Foreground="{Binding ResultKind, Converter={StaticResource ThemeBrush}}"
                                   Visibility="{Binding Result, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="How to set it up" Margin="0,12,0,4" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Caveat}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4"
                                   Visibility="{Binding Caveat, Converter={StaticResource NotEmptyToVis}}" />
                        <ItemsControl ItemsSource="{Binding GuidanceSteps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding StringFormat='• {0}'}" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="The guidance uses Dire Wolf's default ports (AGW 8000, KISS 8001); if 'Dire Wolf's ports' above shows other numbers, use those." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
