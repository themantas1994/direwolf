<UserControl x:Class="DireWolfGui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemTemplate">
            <Grid Margin="0,2" ToolTip="{Binding Detail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Mono}" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding Time}" />
                <Rectangle Grid.Column="1" Width="3" Fill="{Binding Kind, Converter={StaticResource ThemeBrush}}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Mono}" Text="{Binding Text}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Live view of your station. Nothing here transmits; Start only runs Dire Wolf with your configuration." />

            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open setup wizard" Command="{Binding GoCommand}" CommandParameter="SetupWizardViewModel" />
                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                               Text="Dire Wolf Station needs to know where direwolf.exe is and which configuration to use. The setup wizard walks you through audio devices, channels and a safe receive-only test." />
                </DockPanel>
            </Border>

            <WrapPanel>
                <!-- Dire Wolf process -->
                <Border Style="{StaticResource Card}" Width="420">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Dire Wolf" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource Pill}" Background="{Binding Main.StateKind, Converter={StaticResource ThemeBrush}}">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding Main.StateText}" />
                            </Border>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding ProcessSummary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ProcessDetail}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Start" Command="{Binding Main.StartCommand}" Margin="0,0,6,6" Padding="12,4" />
                            <Button Content="Stop" Command="{Binding Main.StopCommand}" Margin="0,0,6,6" Padding="12,4" />
                            <Button Content="Restart" Command="{Binding Main.RestartCommand}" Margin="0,0,6,6" Padding="12,4" />
                            <Button Content="Check configuration" Command="{Binding CheckConfigCommand}" Margin="0,0,6,6" Padding="12,4" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ConfigSummary}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Main.ResourceText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Services -->
                <Border Style="{StaticResource Card}" Width="420">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="What this station does on its own" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ServicesSummary}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2" ToolTip="{Binding Detail}">
                                        <Rectangle DockPanel.Dock="Left" Width="3" Fill="{Binding Kind, Converter={StaticResource ThemeBrush}}" Margin="0,0,8,0" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Text}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Gateway &amp; digipeater…" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding GoCommand}" CommandParameter="ServicesViewModel" />
                    </StackPanel>
                </Border>

                <!-- Client interfaces -->
                <Border Style="{StaticResource Card}" Width="420">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Client programs (AGWPE / KISS)" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding PortsSummary}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding PortsWarning}" Margin="0,6,0,0" Foreground="{DynamicResource WarningBrush}" />
                        <Button Content="External programs…" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding GoCommand}" CommandParameter="IntegrationsViewModel" />
                    </StackPanel>
                </Border>

                <!-- Audio -->
                <Border Style="{StaticResource Card}" Width="420">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Audio" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding AudioSummary}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Received audio levels around 50 give the best results; Dire Wolf warns above 110 and below 5." />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Channels -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Radio channels" />
                    <TextBlock Style="{StaticResource Caption}" Text="As Dire Wolf's own parser reads your configuration. Check the configuration to fill this in."
                               Visibility="{Binding Channels.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                    <DataGrid ItemsSource="{Binding Channels}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" CanUserAddRows="False" MaxHeight="260"
                              Visibility="{Binding Channels.Count, Converter={StaticResource NotEmptyToVis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Margin="4,0" Fill="{Binding StateKind, Converter={StaticResource ThemeBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" />
                            <DataGridTextColumn Header="Call" Binding="{Binding MyCall}" />
                            <DataGridTextColumn Header="Modem" Binding="{Binding Modem}" Width="*" />
                            <DataGridTextColumn Header="PTT" Binding="{Binding Ptt}" />
                            <DataGridTextColumn Header="Packets" Binding="{Binding Activity}" />
                            <DataGridTextColumn Header="Last heard" Binding="{Binding LastHeard}" />
                            <DataGridTextColumn Header="Audio level" Binding="{Binding Level}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="640">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Packet monitor…" Command="{Binding GoCommand}" CommandParameter="MonitorViewModel" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Recent packets" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="No packets yet. Received and transmitted frames appear here while Dire Wolf runs."
                                   Visibility="{Binding RecentPackets.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding RecentPackets}" ItemTemplate="{StaticResource ItemTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="560">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Log…" Command="{Binding GoCommand}" CommandParameter="LogViewModel" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Alerts" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="No warnings or errors."
                                   Visibility="{Binding Alerts.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource ItemTemplate}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
