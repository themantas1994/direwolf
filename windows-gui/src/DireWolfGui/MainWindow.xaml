<Window x:Class="DireWolfGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DireWolfGui.ViewModels"
        Title="{Binding WindowTitle}" Height="820" Width="1320" MinWidth="900" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding StartCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopCommand}" />
        <KeyBinding Key="F5" Modifiers="Ctrl+Shift" Command="{Binding RestartCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="4" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="5" />
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="6" />
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="7" />
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="8" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavWidth, Mode=TwoWay}" MinWidth="56" MaxWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header: station identity and Dire Wolf process control -->
        <Border Grid.ColumnSpan="3" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/direwolf.ico" Width="28" Height="28" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dire Wolf Station" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StationSubtitle}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Background="{Binding StateKind, Converter={StaticResource ThemeBrush}}"
                            ToolTip="{Binding StateDetail}" AutomationProperties.Name="Dire Wolf status">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding StateText}" />
                    </Border>
                    <TextBlock Text="{Binding UptimeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,14,0" />
                    <Button Command="{Binding StartCommand}" ToolTip="Start Dire Wolf (F5)" Margin="0,0,6,0" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}" ToolTip="Stop Dire Wolf cleanly (Shift+F5)" Margin="0,0,6,0" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RestartCommand}" ToolTip="Restart Dire Wolf (Ctrl+Shift+F5)" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Restart" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Background="{DynamicResource WarningBrush}"
                            Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVis}}"
                            ToolTip="The configuration was changed after Dire Wolf started. Restart to apply it.">
                        <TextBlock Style="{StaticResource PillText}" Text="Restart needed" />
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{Binding TransmitKind, Converter={StaticResource ThemeBrush}}"
                            ToolTip="{Binding TransmitDetail}">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding TransmitText}" />
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{Binding MonitorKind, Converter={StaticResource ThemeBrush}}"
                            ToolTip="{Binding MonitorDetail}">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding MonitorText}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigation rail -->
        <Border Grid.Row="1" Background="{DynamicResource NavBackgroundBrush}">
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                     Background="Transparent" BorderThickness="0" Padding="4,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Workspaces">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PageViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="4,6" ToolTip="{Binding ToolTip}">
                            <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" Width="22" />
                            <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False" />

        <!-- Workspace -->
        <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding SelectedPage}" Focusable="False"
                        Margin="16,12,8,8" />

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,3">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding StatusMessage}" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding ClockText}" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding ResourceText}" Margin="16,0,0,0"
                           ToolTip="CPU and memory used by direwolf.exe (and by this application)" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding TrafficText}" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding AlertText}" Margin="16,0,0,0"
                           Foreground="{Binding AlertKind, Converter={StaticResource ThemeBrush}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
