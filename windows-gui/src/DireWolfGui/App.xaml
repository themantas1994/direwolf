<Application x:Class="DireWolfGui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DireWolfGui.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Shared.xaml" />
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Views/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:BoolToVisibilityConverter x:Key="BoolToVis" />
            <c:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
            <c:InverseBoolConverter x:Key="InverseBool" />
            <c:ThemeBrushConverter x:Key="ThemeBrush" />
            <c:DurationConverter x:Key="Duration" />
            <c:LocalTimeConverter x:Key="LocalTime" />
            <c:AgeConverter x:Key="Age" />
            <c:LogSeverityBrushConverter x:Key="LogBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
